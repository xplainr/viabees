---
import '../styles/global.css';
const { title = 'ViaBees' } = Astro.props;
---

<!doctype html>
<html lang="en" class="min-h-screen bg-background text-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <main class="flex flex-col min-h-screen">
      <slot />
    </main>
  </body>
</html>
