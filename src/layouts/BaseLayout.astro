---
import '../styles/global.css';
const { title = 'ViaBees' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    {Astro.renderHead?.()}
  </head>

  <body class="min-h-screen bg-background text-text">
    <h1>LAYOUT RENDERED</h1>
    <slot />
  </body>
</html>
