---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<Fragment slot="head">
  <meta
    name="description"
    content="ViaBees enables instant, privacy-first coupon redemption via NFC or QR. No tracking. Just tap and save."
  />
</Fragment>

<BaseLayout title="ViaBees | Instant Tap Redemption">
  <main class="p-8 text-center bg-surface text-text">
    <img
      src="/viabees-logo.png"
      alt="ViaBees Logo"
      class="mx-auto mb-6 max-w-xs"
      width="200"
      height="200"
      decoding="async"
      loading="lazy"
    />

    <h1 class="text-3xl font-bold text-primary mb-4">Tap. Share. Redeem.</h1>
    <p class="text-secondary text-lg max-w-md mx-auto mb-6">
      ViaBees lets merchants share instant offers—no app, no signup, just one tap.
    </p>

    <div class="flex justify-center gap-4">
      <a
        href="/claim/demo1234567890abcDEF"
        class="px-4 py-2 bg-primary text-white rounded hover:bg-primary/90 transition"
      >
        Try a Demo Coupon
      </a>
    </div>
  </main>
</BaseLayout>
